# Copiar a .env y llenar. .env NUNCA va a git.
# Copernicus CDS (ERA5) — la librería cdsapi lee estas dos variables
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
# NASA Earthdata (GPM IMERG) — la librería earthaccess lee estas variables
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Token de Earthdata (urs.earthdata.nasa.gov → Generate Token). Vence a los ~60 días
EARTHDATA_TOKEN=
# Google Earth Engine — se autentica con `earthengine authenticate`; aquí solo el ID del proyecto
GEE_PROJECT=tu-proyecto-de-earth-engine
