# --- Credenciales (bloque estándar de /credenciales) ---
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
service-account*.json
client_secret*.json
.cdsapirc
**/*[Cc]redencial*
**/*[Cc]redential*
**/*[Ss]ecret*
**/*[Pp]assword*
**/*[Cc]ontrase*
**/*[Ll]laves*
**/*api-key*
**/*apikey*

# Datos y modelos pesados (pesan GB, se regeneran con los scripts)
datos/*
!datos/.gitkeep
modelos/*
!modelos/.gitkeep
*.tif
*.tiff
*.nc
*.zarr/
*.gpkg
*.shp
*.dbf
*.shx

# Entornos y temporales
.venv/
.pixi/
__pycache__/
*.pyc
.ipynb_checkpoints/
node_modules/

# Documentos con datos personales: nunca a git
**/*firmad*
docs/contactos/
